# Standalone funnels site — separate from the storefront. All optional; these are the dev defaults.
PORT=3002

# Where THIS server fetches funnel data from (server-to-server).
API_BASE=http://localhost:3333

# Where visitors' BROWSERS call the API (order submit, communes, analytics). Defaults to API_BASE.
# In production this is the public API origin, and that origin must allow this site's origin via the
# API's CORS_EXTRA_ORIGINS (e.g. CORS_EXTRA_ORIGINS=https://offers.example.com).
PUBLIC_API_BASE=http://localhost:3333

# How long a rendered page is served from memory before it is refreshed (ms). Stale pages are still
# served instantly while a refresh runs in the background, so visitors never wait on the API.
CACHE_TTL_MS=30000
