{
  "name": "funnels",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone, zero-framework funnel pages (landing + order form + upsells) — separate from the storefront, built for speed.",
  "scripts": {
    "dev": "tsx watch --include ./src/client.js src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@amalice/shared": "workspace:*",
    "@rrweb/record": "^2.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
