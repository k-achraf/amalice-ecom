{
  "name": "mcp",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Remote MCP server (Streamable HTTP) that lets AI agents read and operate the Amalice platform through the admin API.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@amalice/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
