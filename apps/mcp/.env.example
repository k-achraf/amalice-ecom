# Remote MCP server for AI agents (Claude, Gemini, ...). See CLAUDE.md in this folder.
# No secrets here: every AI client uses its own token, created in the admin
# (AI -> AI agents (MCP)); the API decides what that token may do.
MCP_PORT=3004
# Bind to loopback; put nginx (HTTPS) in front of it in production.
MCP_HOST=127.0.0.1
API_BASE_URL=http://localhost:3333
