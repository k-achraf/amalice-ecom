generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every state from the order lifecycle state machine (cod-platform-plan.md
// §7) — kept in sync with packages/shared's OrderState Zod enum by hand;
// there is no single source of truth across Prisma and Zod, so changing one
// means changing both.
enum OrderState {
  PendingCallCenter
  CallCenterNoAnswer
  WrongNumber
  Postponed
  Cancelled
  Confirmed
  OnHold
  Packed
  HandedToCourier
  OutForDelivery
  DeliveryFailed
  Delivered
  ReturnedToOrigin
  Restocked
  CashCollected
  Reconciled
  Settled
  // A post-confirmation cancellation (fulfillment/shipping) — distinct from
  // the pre-confirmation Cancelled above so the derived call-center/shipping
  // tracks (see order.ts's deriveCallCenterState/deriveShippingState) can
  // tell the two apart unambiguously. See packages/shared's OrderState
  // comment for the full reasoning.
  CancelledShipping
}

// The five roles from cod-platform-plan.md §8.
enum AdminRoleName {
  SuperAdmin
  OpsManager
  Finance
  Support
  Warehouse
  // Narrower than Support — scoped to just the call-center confirmation
  // workflow (Call Center queue + Drop Queue, and an individual order's
  // detail reached through those). See AdminRoleNameSchema's comment
  // (packages/shared) for the Support-vs-CallCenterAgent distinction.
  CallCenterAgent
}

model Customer {
  id        String    @id @default(uuid())
  phone     String    @unique
  name      String?
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String   @map("postal_code")
  country    String   @db.Char(2)
  orders     Order[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("addresses")
}

// SF-17 — collection/category landing pages need a real source (name,
// description, image) beyond the flat `Product.category` tag. Kept optional
// on Product so existing seeded products keep working without a backfill.
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  // Curated storefront placement flags — used by SF-18 marketing home, not
  // a separate marketing table (per SF-18's v1 scope decision).
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0) @map("sort_order")
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                    String               @id @default(uuid())
  name                  String
  slug                  String               @unique
  description           String?
  // Flat tag kept for back-compat with seeded data and the existing
  // ?category= filter; categoryId is the normalized FK (SF-17). Both can
  // coexist — categoryId is authoritative when set.
  category              String?
  categoryId            String?              @map("category_id")
  categoryRef           Category?            @relation(fields: [categoryId], references: [id])
  // SF-15: primary image (gallery's first/hero). The ProductImage rows are
  // the full gallery; this denormalized field is the fast path for cards.
  imageUrl              String?              @map("image_url")
  images                ProductImage[]
  // SF-15: variants (size/color/etc.). A product with no variants is
  // single-SKU and behaves exactly as before — variant rows are optional.
  variants              ProductVariant[]
  // Which attributes apply to this product (the product "uses" Color + Size).
  // Drives the variant-manager UI: before creating variants, you apply the
  // attributes the variants will vary on.
  productAttributes     ProductAttribute[]
  // Curated "featured/best-seller" flags for SF-18 marketing home, not a
  // separate marketing table.
  featured              Boolean              @default(false)
  bestSeller            Boolean              @default(false) @map("best_seller")
  // Unlisted-product toggle — false hides the product from every discovery
  // surface (catalog, collections, search, home featured/best-seller
  // sections, related products) but does NOT block direct access: the
  // product page (/products/:slug) and any AI landing pages
  // (/lp/:productSlug/:number) still work when linked to directly. Built for
  // ad-only funnel products that should never be publicly browsable. Not the
  // same as stockQuantity=0 ("archived"/out-of-stock, still listed) — this
  // is purely a discoverability switch, independent of stock.
  visible               Boolean              @default(true)
  priceCents            Int                  @map("price_cents")
  stockQuantity         Int                  @default(0) @map("stock_quantity")
  lowStockThreshold     Int                  @default(5) @map("low_stock_threshold")
  orderItems            OrderItem[]
  reviews               Review[]
  stockAdjustments      StockAdjustment[]
  // AI-generated long-scroll landing pages — a product can have several
  // (different creative angles, each its own storefront URL), see
  // ProductLandingPage below.
  landingPages          ProductLandingPage[]
  // Quantity-based promos (buy 2 for a bundle price, buy 2 get 1 free, buy 2
  // free shipping) — see ProductOffer below.
  offers                ProductOffer[]
  // For products only ever sold in fixed lots (e.g. wholesale packs of 40 or
  // 80 units, never a single unit) — when true, the storefront PDP hides its
  // free-quantity stepper entirely and the customer must pick one of this
  // product's enabled ProductOffers (the first enabled one pre-selected by
  // default) to set quantity at all. Reuses the existing offers system
  // (FixedBundlePrice is exactly "N units for a set price") rather than a
  // parallel mechanism — this flag only changes whether picking one is
  // optional (false, the normal promo-upsell behavior) or the sole way to
  // buy (true). Meaningless with zero enabled offers; the admin UI warns
  // rather than silently making the product unbuyable.
  requireOfferSelection Boolean              @default(false) @map("require_offer_selection")
  // Upsells system — products suggested when THIS product is bought
  // (upsellsOffered) vs configs where THIS product IS the suggested upsell
  // for some other product (upsellsAsTarget). See ProductUpsell below.
  upsellsOffered        ProductUpsell[]      @relation("UpsellTrigger")
  upsellsAsTarget       ProductUpsell[]      @relation("UpsellTarget")
  googleSheets          ProductGoogleSheet[]
  // Reverse of SourcedProduct.linkedProductId — the research/ad-testing
  // candidate this product came from, when it went through that pipeline
  // rather than being created directly.
  sourcedFrom           SourcedProduct?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@index([category])
  @@index([categoryId])
  @@map("products")
}

// AI landing page builder — sends the product's photos + description to an
// image-generation model, which produces a handful of section images (hero,
// feature highlights, CTA), each with marketing copy and visual effects
// baked in; the sections are then stitched vertically into one long image
// (the classic AliExpress/TikTok-ad style product funnel image). A product
// can have MULTIPLE landing pages (different angles/creative for different
// ad campaigns), each independently generated, named, enabled, and reachable
// at its own storefront URL (/lp/:productSlug/:number — never a raw id/uuid
// — a standalone chromeless page: no header/nav, just the stitched image +
// a lead form at the bottom; separate from and in addition to the normal
// /products/:slug page, never replacing it). Regenerating a specific landing
// page still replaces its own content
// in place — this is a working draft the merchant iterates on, not an audit
// trail — but generating a NEW one is a new row, not an upsert.
enum LandingPageStatus {
  Pending
  Generating
  Completed
  Failed
}

// Which backend produces the section images. Gemini (Nano Banana) edits the
// product's own photos and draws on-image text itself, but Google now
// requires Cloud billing enabled for any image-output model — even at
// near-zero cost, it's not in the truly free tier. Pollinations is free and
// keyless with no billing step, but it's text-to-image only (generates a
// generic product-style image rather than editing the real photos) and can't
// render legible on-image text, so text is composited on afterwards in code
// (see text-overlay.util.ts) instead of drawn by the model.
enum LandingPageImageProvider {
  Gemini
  Pollinations
}

model ProductLandingPage {
  id            String                   @id @default(uuid())
  productId     String                   @map("product_id")
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // The second segment of /lp/:productSlug/:number — sequential per product
  // (1, 2, 3, ...), assigned automatically at generation time. Deliberately
  // not a slug/uuid: the product's own slug already carries the SEO/sharing
  // identity, this just distinguishes multiple landing pages for it.
  number        Int
  // Admin-facing label to tell multiple landing pages for the same product
  // apart in the list UI (e.g. "TikTok angle", "Black Friday") — purely
  // cosmetic, never shown to a storefront visitor.
  name          String                   @default("Landing Page")
  // Whether this specific landing page is publicly reachable at its URL.
  // Independent of `status` — a merchant can generate, preview, and only
  // flip this on once they like the result. Each landing page has its own
  // switch now that a product can have several.
  enabled       Boolean                  @default(false)
  status        LandingPageStatus        @default(Pending)
  imageProvider LandingPageImageProvider @default(Gemini) @map("image_provider")
  // The final vertically-stitched long image — null until status=Completed.
  finalImageUrl String?                  @map("final_image_url")
  // Array of LandingPageSection (packages/shared/src/landing-page.ts) — each
  // section's copy, source images, generated image, and per-section status,
  // so a single bad section can be regenerated without redoing the rest.
  sections      Json                     @default("[]")
  errorMessage  String?                  @map("error_message")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@unique([productId, number])
  @@map("product_landing_pages")
}

// SF-15 — multi-image gallery, ordered. Falls back to Product.imageUrl when
// a product has no gallery rows (single-image behavior unchanged).
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId])
  @@map("product_images")
}

// SF-15 — variants. Each carries its own price/stock/sku; selecting one
// updates the PDP and the add-to-cart payload. Product.stockQuantity is the
// aggregate for single-SKU products; when variants exist, per-variant stock
// is authoritative.
model ProductVariant {
  id            String          @id @default(uuid())
  productId     String          @map("product_id")
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String          @unique
  // Legacy free-form JSON attribute map, kept for back-compat. Superseded by
  // the normalized VariantOption relation below — new code reads options[]
  // and builds the same {key: value} shape. This field is no longer the
  // source of truth but remains populated for older variants.
  attributes    Json
  priceCents    Int             @map("price_cents")
  stockQuantity Int             @default(0) @map("stock_quantity")
  // Normalized: which option this variant picked for each of its attributes.
  options       VariantOption[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ADM-07 — stock adjustments with a reason code, audit-tracked. Every
// stockQuantity change writes a row here; the admin inventory screen reads
// it as the adjustment history.
enum StockAdjustmentReason {
  Restock
  Correction
  Damage
  Sale
  Return
}

model StockAdjustment {
  id        String                @id @default(uuid())
  productId String                @map("product_id")
  product   Product               @relation(fields: [productId], references: [id])
  // Signed delta — positive for stock-in, negative for stock-out. The
  // absolute quantity is |delta|; sign carries direction.
  delta     Int
  reason    StockAdjustmentReason
  note      String?
  // Who made the change — nullable so the seed/initial stock doesn't require
  // a fake admin actor, but every real admin action is attributed.
  actorId   String?               @map("actor_id")
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([productId])
  @@index([actorId])
  @@map("stock_adjustments")
}

// Full product management — normalized attribute/option system.
// Attribute is a store-wide definition (Color, Size); AttributeOption is its
// allowed values (Red, Blue, M, L). ProductAttribute links a product to the
// attributes it varies on. VariantOption links a variant to its chosen option
// per attribute. This replaces the free-form JSON `attributes` blob on
// ProductVariant as the source of truth — structured, validated, reusable.

enum AttributeType {
  Text
  Color
  Number
  Swatch
  Size
  Boolean
  Measurement
}

model Attribute {
  id        String             @id @default(uuid())
  name      String             @unique
  type      AttributeType      @default(Text)
  sortOrder Int                @default(0) @map("sort_order")
  options   AttributeOption[]
  products  ProductAttribute[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("attributes")
}

model AttributeOption {
  id           String          @id @default(uuid())
  attributeId  String          @map("attribute_id")
  attribute    Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String
  displayValue String?         @map("display_value")
  // For Color-type attributes: the hex swatch. Null for non-color attributes.
  colorHex     String?         @map("color_hex")
  sortOrder    Int             @default(0) @map("sort_order")
  variants     VariantOption[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_options")
}

// Which attributes a product uses (the product "varies on" these).
// A product must have ProductAttribute rows before variants can be created —
// the variant manager shows these as option selectors.
model ProductAttribute {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@map("product_attributes")
}

// Which option a variant picked for each of its product's attributes.
// One row per (variant, option). The unique pair prevents a variant from
// picking the same option twice.
model VariantOption {
  id        String          @id @default(uuid())
  variantId String          @map("variant_id")
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String          @map("option_id")
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
  @@index([variantId])
  @@index([optionId])
  @@map("variant_options")
}

// SF-16 — reviews. Phone-OTP gated, one per customer+product, moderation
// via the `approved` flag (no auto-publish). Anti-spam: only customers with
// a delivered order for this product can review (checked in service, not
// schema-enforceable).
model Review {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int // 1–5
  title      String?
  body       String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // One review per customer+product — enforced structurally, not just app-level.
  @@unique([productId, customerId])
  @@index([productId, approved])
  @@map("reviews")
}

model Courier {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  shipments         Shipment[]
  remittanceBatches RemittanceBatch[]
  createdAt         DateTime          @default(now()) @map("created_at")

  @@map("couriers")
}

model Order {
  id                   String                @id @default(uuid())
  customerId           String                @map("customer_id")
  customer             Customer              @relation(fields: [customerId], references: [id])
  addressId            String                @map("address_id")
  address              Address               @relation(fields: [addressId], references: [id])
  state                OrderState            @default(PendingCallCenter)
  // Total amount actually due (items + shipping) — the number shown as
  // "cash due on delivery" everywhere. shippingPriceCents is the shipping
  // portion of it, priced server-side from WilayaShippingRate at order time
  // (never trusts a client-submitted price — same rule as ProductOffer
  // pricing); shippingType is null only for pre-shipping-feature historical
  // orders, never for new ones.
  totalCents           Int                   @map("total_cents")
  shippingType         ShippingType?         @map("shipping_type")
  shippingPriceCents   Int                   @default(0) @map("shipping_price_cents")
  // True for an order auto-created from an unfinished lead form (customer
  // typed a phone number, then went idle past the store's configured
  // abandoned-cart delay without submitting — see
  // OrdersService.createAbandonedOrder). Lets call-center staff see this was
  // never actually confirmed by the customer, not a fabricated real order.
  // Cleared in place (never a second row) if the same customer goes on to
  // actually submit the form — see createLeadOrder's convertsAbandonedOrderId.
  isAbandoned          Boolean               @default(false) @map("is_abandoned")
  // Which shipping company (if any) this order is assigned to before it can
  // be dispatched — deliberately NOT auto-resolved from whichever company is
  // "default" at dispatch time (that was the earlier behavior; a manual
  // in-house delivery has no shipping company at all, and different orders
  // may legitimately go through different companies). Unassigned is the
  // starting state for every order reaching fulfillment; dispatch requires
  // ShippingCompany + shippingCompanyId set, or Manual (see FulfillmentService).
  fulfillmentMethod    FulfillmentMethod     @default(Unassigned) @map("fulfillment_method")
  shippingCompanyId    String?               @map("shipping_company_id")
  shippingCompany      ShippingCompany?      @relation(fields: [shippingCompanyId], references: [id], onDelete: SetNull)
  // Free-text call-center notes — see UpdateOrderNotesSchema. Also mirrored
  // into the Google Sheets integration's Notes column (GoogleSheetsService).
  notes                String?
  // When a call-center agent postpones an order (transition to Postponed),
  // they must now pick a follow-up date/time — this is it. The Drop Queue
  // hides a Postponed order until this is reached (see
  // AdminOrdersService.dropQueue's where clause), instead of showing it
  // again immediately. Cleared back to null on any other transition (a
  // stale date from an old postponement shouldn't linger once the order
  // moves on). Null for Postponed orders that predate this field —
  // dropQueue treats a null postponedUntil as "no date on record, show it"
  // rather than hiding it forever.
  postponedUntil       DateTime?             @map("postponed_until")
  // Set when OrdersService.findRecentDuplicate finds a prior (non-abandoned)
  // order for the same customer sharing at least one product within the
  // last 2 days — never blocks the order, just flags it so call-center can
  // spot an accidental double-submit or bot-driven repeat at a glance.
  // duplicateOfOrderId points at the earlier order it matched, kept even if
  // that order is later cancelled/deleted-in-spirit (SetNull, not cascade —
  // this flag itself should survive independent of the other row's fate).
  isDuplicate          Boolean               @default(false) @map("is_duplicate")
  duplicateOfOrderId   String?               @map("duplicate_of_order_id")
  duplicateOfOrder     Order?                @relation("OrderDuplicate", fields: [duplicateOfOrderId], references: [id], onDelete: SetNull)
  duplicateOrders      Order[]               @relation("OrderDuplicate")
  items                OrderItem[]
  shipment             Shipment?
  cashReconciliation   CashReconciliation?
  ledgerEntries        LedgerEntry[]
  notifications        Notification[]
  googleSheetRows      GoogleSheetOrderRow[]
  courierWebhookEvents CourierWebhookEvent[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([state])
  @@index([duplicateOfOrderId])
  @@index([shippingCompanyId])
  @@map("orders")
}

enum FulfillmentMethod {
  Unassigned
  ShippingCompany
  Manual
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String          @map("order_id")
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String          @map("product_id")
  product        Product         @relation(fields: [productId], references: [id])
  // Which variant (if any) was ordered — null for a variant-less product, or
  // for a variant-less purchase of one that has variants (rare but allowed).
  // Kept even if the variant is later deleted, same traceability reasoning
  // as offerId below (SetNull, not cascade-delete of order history).
  variantId      String?         @map("variant_id")
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int
  // Reference (undiscounted) per-unit price at order time — for "was $X"
  // messaging, NOT the amount actually charged for this line. Use
  // lineTotalCents for that; it's what's actually summed into Order.totalCents.
  unitPriceCents Int             @map("unit_price_cents")
  // What was actually charged for this line. Equals unitPriceCents*quantity
  // for a plain purchase, but a ProductOffer (bundle price, or buy-X-get-Y
  // where quantity includes the free units) can make it diverge — stored
  // explicitly rather than reconstructed, since bundle/free-unit math doesn't
  // always divide evenly back into a clean per-unit cents figure.
  lineTotalCents Int             @default(0) @map("line_total_cents")
  // Which offer (if any) produced lineTotalCents — kept even if the offer is
  // later deleted, purely for admin/order-history traceability.
  offerId        String?         @map("offer_id")
  offer          ProductOffer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  // True when added via the upsells system (call-center manual add, admin
  // add-item, or the storefront post-checkout upsell page) rather than being
  // part of the original checkout — see OrderItemsService.
  isUpsell       Boolean         @default(false) @map("is_upsell")

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// Quantity-triggered product promos — the storefront PDP shows these as
// pickable "offer cards" (see the customer-picks-a-card decision in the
// landing-page/offers design discussion): choosing one sets the buy
// quantity to exactly what the offer needs and locks in its pricing. Not
// auto-detected from an arbitrary quantity — avoids ambiguity when multiple
// offers could technically apply to the same number of units.
enum ProductOfferType {
  // "Buy 2 for $40" — requiredQuantity units for a flat bundlePriceCents.
  FixedBundlePrice
  // "Buy 2, get 1 free" — pay for requiredQuantity, receive
  // requiredQuantity+freeQuantity units total.
  BuyXGetYFree
  // "Buy 2, free shipping" — display-only for now: there is no shipping-fee
  // concept in the system yet, so this doesn't change the order total, only
  // shows a badge. Wire it to a real discount once shipping fees exist.
  FreeShipping
}

model ProductOffer {
  id               String           @id @default(uuid())
  productId        String           @map("product_id")
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             ProductOfferType
  enabled          Boolean          @default(true)
  requiredQuantity Int              @map("required_quantity")
  // BuyXGetYFree only — extra free units on top of requiredQuantity.
  freeQuantity     Int              @default(0) @map("free_quantity")
  // FixedBundlePrice only — total price (cents) for requiredQuantity units.
  bundlePriceCents Int?             @map("bundle_price_cents")
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_offers")
}

// Upsells system — "customers who buy productId are offered
// upsellProductId", surfaced on the storefront's post-checkout upsell page
// after a customer places an order. Per-trigger-product (not global),
// same granularity as ProductOffer. priceCentsOverride lets the upsell be
// pitched at a special price distinct from the target product's normal
// price (null = normal price). A (productId, upsellProductId) pair is
// unique — configuring the same pairing twice would just be ambiguous
// about which row wins.
model ProductUpsell {
  id                 String   @id @default(uuid())
  productId          String   @map("product_id")
  product            Product  @relation("UpsellTrigger", fields: [productId], references: [id], onDelete: Cascade)
  upsellProductId    String   @map("upsell_product_id")
  upsellProduct      Product  @relation("UpsellTarget", fields: [upsellProductId], references: [id], onDelete: Cascade)
  enabled            Boolean  @default(true)
  priceCentsOverride Int?     @map("price_cents_override")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([productId, upsellProductId])
  @@index([productId])
  @@map("product_upsells")
}

model Shipment {
  id                String   @id @default(uuid())
  orderId           String   @unique @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id])
  courierId         String   @map("courier_id")
  courier           Courier  @relation(fields: [courierId], references: [id])
  trackingReference String?  @map("tracking_reference")
  courierStatus     String?  @map("courier_status")
  // Filled in from a courier webhook payload when the courier reports a
  // driver assignment (e.g. DHD's webhook `data.driver` object) — null
  // until then, and either can independently be blank/absent even once a
  // driver row exists (some couriers report a name without a phone, etc.).
  driverName        String?  @map("driver_name")
  driverPhone       String?  @map("driver_phone")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([courierId])
  @@map("shipments")
}

// One row per order — the per-order reconciliation state. FIN-01's
// RemittanceBatch/LedgerEntry (below) is the richer batch/ledger model on
// top; this stays as the fast per-order "is this reconciled" flag.
model CashReconciliation {
  id             String    @id @default(uuid())
  orderId        String    @unique @map("order_id")
  order          Order     @relation(fields: [orderId], references: [id])
  expectedCents  Int       @map("expected_cents")
  collectedCents Int?      @map("collected_cents")
  matched        Boolean   @default(false)
  reconciledAt   DateTime? @map("reconciled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("cash_reconciliations")
}

// FIN-01 — one per courier cash handover (a remittance batch). Immutable
// once created; corrections happen via a new adjustment LedgerEntry, not an
// edit (the immutable-ledger rule from plan §7 — nobody hard-deletes from
// this chain).
enum RemittanceBatchStatus {
  Imported
  Matched
  Settled
  Discrepancy
}

model RemittanceBatch {
  id            String                @id @default(uuid())
  courierId     String                @map("courier_id")
  courier       Courier               @relation(fields: [courierId], references: [id])
  // The courier's own reference for this cash handover (date range, batch id).
  reference     String
  // Period the batch covers — the dates the cash was collected over.
  periodStart   DateTime              @map("period_start")
  periodEnd     DateTime              @map("period_end")
  totalCents    Int                   @map("total_cents")
  status        RemittanceBatchStatus @default(Imported)
  ledgerEntries LedgerEntry[]
  createdAt     DateTime              @default(now()) @map("created_at")

  @@unique([courierId, reference])
  @@index([courierId])
  @@map("remittance_batches")
}

// FIN-01 — one per order within a batch. The unique constraint on
// order↔batch makes double-counting an order structurally hard, not just an
// app-level check (per FIN-01's acceptance criteria).
enum LedgerEntryStatus {
  Matched
  Mismatch
  Unmatched
  Resolved
}

model LedgerEntry {
  id             String            @id @default(uuid())
  batchId        String            @map("batch_id")
  batch          RemittanceBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId        String?           @map("order_id")
  order          Order?            @relation(fields: [orderId], references: [id])
  // The courier's reference for this line (tracking id, order ref) — what
  // auto-matching joins on.
  courierRef     String            @map("courier_ref")
  expectedCents  Int?              @map("expected_cents") // resolved when matched to an order
  collectedCents Int               @map("collected_cents")
  status         LedgerEntryStatus @default(Unmatched)
  resolutionNote String?           @map("resolution_note")
  createdAt      DateTime          @default(now()) @map("created_at")

  // One order per batch — structural double-count prevention.
  @@unique([batchId, orderId])
  @@index([batchId])
  @@index([status])
  @@map("ledger_entries")
}

model Role {
  id         String        @id @default(uuid())
  name       AdminRoleName @unique
  adminUsers AdminUser[]

  @@map("roles")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id")
  role         Role     @relation(fields: [roleId], references: [id])
  // ADM-06 — deactivated users can't log in (AdminAuthService.login checks
  // this). Existing JWT session invalidation on deactivate is SEC-track.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("admin_users")
}

enum NotificationChannel {
  SMS
  WhatsApp
  Email
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

model Notification {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  recipient String
  message   String
  status    NotificationStatus  @default(Pending)
  orderId   String?             @map("order_id")
  order     Order?              @relation(fields: [orderId], references: [id])
  attempts  Int                 @default(0)
  lastError String?             @map("last_error")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("notifications")
}

// SEC-03 — the immutable audit log. Every order-status change, stock
// adjustment, and reconciliation edit writes a row here. This is the one
// table in the system nobody gets to hard-delete from (plan §7) — there is
// no delete affordance anywhere, and the admin viewer (ADM-08) is read-only.
// `metadata` is JSON for the before/after payload — the shape varies per
// entity type, a fixed column set would fight that.
enum AuditAction {
  Create
  Update
  Delete
  StateTransition
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?     @map("actor_id") // nullable: system/seed events have no human actor
  actorEmail String?     @map("actor_email")
  action     AuditAction
  // "Order", "Product", "CashReconciliation", etc. — not a polymorphic FK
  // (Prisma doesn't do those cleanly), just a typed entity discriminator +
  // the target's id. The viewer joins in code by (entity, entityId).
  entity     String
  entityId   String      @map("entity_id")
  // Structured before/after — e.g. { from: "Confirmed", to: "Packed" } for a
  // state transition, or { field: "stockQuantity", from: 5, to: 40 } for a
  // stock adjustment.
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Operational error/warning logs — distinct from AuditLog above (which
// records business events like "order state changed"): this is every
// `Logger.warn()`/`Logger.error()` call the API code makes anywhere (stock
// adjustment races, DHD webhook signature failures, Google Sheets push
// failures, etc.), captured via PersistentLogger (see common/) so ops staff
// can see them from the admin dashboard instead of needing SSH + `pm2 logs`.
// Still prints to stdout/PM2's own log files as before — this is additive,
// not a replacement — and is capped by PersistentLogger's own periodic
// pruning (not itself an audit trail, so unlike AuditLog it's fine to age
// old rows out).
enum ServerLogLevel {
  Warn
  Error
}

model ServerLog {
  id        String         @id @default(uuid())
  level     ServerLogLevel
  // The Logger instance's context — usually a class name (e.g.
  // "DhdWebhookService") — null if a call site logged without one.
  context   String?
  message   String
  // Stack trace, only ever present for .error() calls that included one.
  trace     String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([level])
  @@index([createdAt])
  @@map("server_logs")
}

// Single-row store configuration — the storefront template picker and
// store-name/announcement that the admin controls and the storefront reads.
// Singleton row (id = "singleton"); upserted, never deleted. Template changes
// are audit-logged like every other operator mutation (SEC-03).
model StoreSettings {
  id                        String   @id @default("singleton")
  // One of STORE_TEMPLATES (packages/shared): "minimal" | "editorial" | "boutique" | "promify".
  // Validated server-side against the registry; drives the storefront's layout.
  activeTemplate            String   @default("minimal") @map("active_template")
  storeName                 String   @default("Amalice") @map("store_name")
  // Drives the header announcement bar (nullable = no announcement shown).
  announcementText          String?  @map("announcement_text")
  // When true: cart icon + cart page + OTP checkout (default). When false:
  // hide cart, show a lead-capture form directly on the PDP instead.
  displayCart               Boolean  @default(true) @map("display_cart")
  // Admin-configurable lead form fields (JSON array of LeadFormField). Null =
  // use the default 4 fields (name, phone, wilaya, commune). When set, the
  // storefront renders these dynamically on the PDP lead form.
  leadFormConfig            Json?    @map("lead_form_config")
  // How long (seconds) a customer can sit idle after typing a phone number
  // on the lead form, without submitting, before the storefront fires the
  // abandoned-cart order creation. See OrdersService.createAbandonedOrder.
  abandonedCartDelaySeconds Int      @default(60) @map("abandoned_cart_delay_seconds")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// Installable storefront "apps" (Meta Pixel is the first). One row per app,
// keyed by a stable slug from the APP_IDS registry (packages/shared/apps.ts)
// rather than an app-specific table — new apps are new rows, not new
// migrations. `config` is a per-app JSON blob validated server-side against
// that app's own Zod schema before being written (e.g. MetaPixelConfigSchema
// for appId "meta-pixel"). Enable/disable + config changes are audit-logged
// like every other operator mutation (SEC-03).
model AppInstallation {
  id        String   @id @default(uuid())
  appId     String   @unique @map("app_id")
  enabled   Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_installations")
}

// Google Sheets integration (appId "google-sheets" on AppInstallation gates
// the whole feature as a master on/off switch, same as every other app) —
// one row per connected spreadsheet+tab. Deliberately NOT a single
// AppInstallation.config blob like the pixel apps: this needs many rows
// (a store can push to several sheets) plus a many-to-many product mapping,
// neither of which fits a JSON blob well.
//
// Routing is dynamic per the two bullet points this was built for: a sheet
// with appliesToAllProducts=true receives every order regardless of what was
// bought (the "connect all products to the same sheet" case); otherwise it
// only receives orders containing at least one product in `products` below
// (the "connect a product to multiple sheets" case — a product can appear in
// many ProductGoogleSheet rows, one per sheet). An order can therefore fan
// out to more than one sheet if it matches more than one.
model GoogleSheet {
  id                   String                @id @default(uuid())
  // Admin-facing label only — not sent to Google.
  name                 String
  // The long id segment from the sheet's URL
  // (docs.google.com/spreadsheets/d/{spreadsheetId}/edit), not the full URL —
  // validated/extracted server-side so admins can just paste the URL.
  spreadsheetId        String                @map("spreadsheet_id")
  // Tab name within the spreadsheet, e.g. "Orders". Created if missing on
  // first successful push (see GoogleSheetsClientService.ensureSheetReady).
  sheetName            String                @default("Orders") @map("sheet_name")
  appliesToAllProducts Boolean               @default(false) @map("applies_to_all_products")
  enabled              Boolean               @default(true)
  products             ProductGoogleSheet[]
  orderRows            GoogleSheetOrderRow[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("google_sheets")
}

// Many-to-many join — see GoogleSheet's comment above for the routing rules
// this drives. Ignored for sheets where appliesToAllProducts=true.
model ProductGoogleSheet {
  productId     String      @map("product_id")
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  googleSheetId String      @map("google_sheet_id")
  googleSheet   GoogleSheet @relation(fields: [googleSheetId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@id([productId, googleSheetId])
  @@index([googleSheetId])
  @@map("product_google_sheets")
}

// Tracks which sheet row an order was appended to, so a later status change
// can target that exact row (Sheets API range update) instead of re-scanning
// the whole sheet for a matching Order ID on every transition. One row per
// (order, sheet) pair — an order that fans out to multiple sheets gets one
// of these per sheet it landed in.
model GoogleSheetOrderRow {
  id            String      @id @default(uuid())
  orderId       String      @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  googleSheetId String      @map("google_sheet_id")
  googleSheet   GoogleSheet @relation(fields: [googleSheetId], references: [id], onDelete: Cascade)
  // 1-indexed row number within sheetName at the time of the append. Sheets
  // never reflows existing rows on its own, so this stays valid for status
  // updates — it would only go stale if someone manually deletes/reorders
  // rows in the sheet, which is outside this system's control anyway.
  rowNumber     Int         @map("row_number")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([orderId, googleSheetId])
  @@index([googleSheetId])
  @@map("google_sheet_order_rows")
}

// Algeria administrative divisions — reference data imported from
// github.com/Kenandarabeh/algeria-wilayas-communes-2026 (apps/api/prisma/data/,
// vendored rather than fetched at seed time so seeding never depends on
// network access). Read-only lookup tables: no admin CRUD, seeded once and
// re-synced only via a fresh vendor + reseed. `id` is the source dataset's
// own id/code (a small stable string, "1".."69" for wilayas) rather than a
// generated uuid — natural key for reference data with a single external
// source of truth. Backs the storefront lead form's wilaya/commune selects
// (GET /wilayas, GET /communes?wilayaId=) — Address.region/city stay plain
// strings (the commune/wilaya *name*), so no FK from Address into these.
model Wilaya {
  id             String                  @id
  name           String
  communes       Commune[]
  shippingRate   WilayaShippingRate?
  companyTariffs ShippingCompanyTariff[]

  @@map("wilayas")
}

enum ShippingType {
  Home
  Desk
}

// Per-wilaya delivery pricing — home delivery and desk (courier office
// pickup) delivery are priced and enabled INDEPENDENTLY, since real Algeria
// couriers commonly only offer desk delivery to remote wilayas. A wilaya
// with both disabled (or no row at all — the default until an admin
// configures it) has no shipping options and can't be ordered to; the
// storefront's wilaya list stays fully populated regardless (address
// lookup and delivery availability are separate concerns), it's just the
// shipping-type picker that comes up empty.
model WilayaShippingRate {
  id                     String   @id @default(uuid())
  wilayaId               String   @unique @map("wilaya_id")
  wilaya                 Wilaya   @relation(fields: [wilayaId], references: [id], onDelete: Cascade)
  homeDeliveryEnabled    Boolean  @default(false) @map("home_delivery_enabled")
  homeDeliveryPriceCents Int?     @map("home_delivery_price_cents")
  deskDeliveryEnabled    Boolean  @default(false) @map("desk_delivery_enabled")
  deskDeliveryPriceCents Int?     @map("desk_delivery_price_cents")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("wilaya_shipping_rates")
}

model Commune {
  id       String @id
  name     String
  postCode String @map("post_code")
  wilayaId String @map("wilaya_id")
  wilaya   Wilaya @relation(fields: [wilayaId], references: [id])

  @@index([wilayaId])
  @@map("communes")
}

// Third-party courier integrations (DHD first, more to come — see the
// "Shipping Companies" admin section). One row per provider: `apiToken` is a
// write-only secret from the admin's perspective (masked to hasApiToken on
// every read, same convention as AppInstallation's accessToken fields in
// apps.service.ts). `isLinked` flips true only after the token has been
// verified against the provider's own token-validation endpoint — a row can
// exist (baseUrl pre-filled) without ever having been successfully linked.
// `isDefault` marks which linked company the order-fulfillment flow should
// prefer when more than one is linked; enforced single-true by
// ShippingCompaniesService, not a DB constraint (Prisma/Postgres can't
// express "at most one true" as a unique index without a partial index this
// schema doesn't otherwise use).
enum ShippingCompanyProvider {
  Dhd
}

model ShippingCompany {
  id            String                  @id @default(uuid())
  provider      ShippingCompanyProvider @unique
  name          String
  baseUrl       String                  @map("base_url")
  apiToken      String?                 @map("api_token")
  // HMAC-SHA256 secret the provider's webhook config signs each inbound
  // request with — pasted in from whatever value the provider's own
  // platform generated/the admin set when configuring the webhook there
  // (see SetWebhookSecretSchema). Never generated on our side, since it has
  // to match exactly what the provider is actually signing with.
  webhookSecret String?                 @map("webhook_secret")
  isLinked      Boolean                 @default(false) @map("is_linked")
  isDefault     Boolean                 @default(false) @map("is_default")
  lastSyncedAt  DateTime?               @map("last_synced_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  tariffs       ShippingCompanyTariff[]
  orders        Order[]
  webhookEvents CourierWebhookEvent[]

  @@map("shipping_companies")
}

// One row per inbound courier webhook delivery — audit log AND the
// idempotency mechanism DHD's own docs recommend ("use tracking + event as
// a dedup key" — see DhdWebhookService). The unique constraint below IS
// that dedup key: a retried delivery of the same event for the same
// tracking number hits it and is treated as already-processed rather than
// re-applying the state transition a second time.
model CourierWebhookEvent {
  id                String          @id @default(uuid())
  shippingCompanyId String          @map("shipping_company_id")
  shippingCompany   ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: Cascade)
  trackingReference String          @map("tracking_reference")
  // The raw `event` string (e.g. "order.delivering") — see
  // DHD_WEBHOOK_EVENT_TO_STATE for how this maps onto our OrderState.
  event             String
  stateId           Int             @map("state_id")
  payload           Json
  // Order this event resolved to, if the tracking reference matched a real
  // shipment — null for a delivery from an unrecognized tracking number
  // (still logged, just can't be linked to an order).
  orderId           String?         @map("order_id")
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Whether an order-state transition was actually applied for this event
  // (false for informational-only events, an already-current state, an
  // invalid transition, or an unmatched tracking reference).
  applied           Boolean         @default(false)
  error             String?
  receivedAt        DateTime        @default(now()) @map("received_at")

  @@unique([shippingCompanyId, trackingReference, event])
  @@index([trackingReference])
  @@index([orderId])
  @@map("courier_webhook_events")
}

// The RAW inbound delivery log — every single request that ever hits
// /webhooks/dhd/:shippingCompanyId, unconditionally, before any validation
// happens. This is deliberately separate from CourierWebhookEvent above:
// that table can only ever hold a row for a request that made it all the
// way through signature verification AND payload parsing, so a run of 401s
// or 400s (wrong/missing signature, malformed body, unknown company id)
// left the admin's webhook log looking completely empty — there was
// nowhere for a *failed* delivery to be recorded. This table exists
// specifically to make failed attempts visible: raw headers, raw body,
// what the signature check decided, and the HTTP status we actually sent
// back, captured in DhdWebhookService.handle()'s try/finally so it's
// written no matter which check (if any) rejected the request.
model CourierWebhookLog {
  id                String   @id @default(uuid())
  // Not a foreign key to ShippingCompany — the whole point is to still log
  // a request whose :shippingCompanyId doesn't match any real row (a wrong
  // URL configured on the provider's side is itself something worth seeing
  // here, not silently dropped for failing that lookup).
  shippingCompanyId String?  @map("shipping_company_id")
  provider          String
  method            String
  path              String
  // Full request headers as received (object of string -> string | string[],
  // same shape Node's http module exposes) — Signature, Content-Type,
  // User-Agent, everything, so a "DHD isn't sending what their docs say"
  // question can be answered by looking at one row instead of asking DHD.
  headers           Json
  // Raw body as received, decoded as UTF-8 text (DHD's payloads are JSON,
  // small) — capped defensively so one adversarial/broken delivery can't
  // bloat a row unboundedly.
  rawBody           String?  @map("raw_body")
  signatureHeader   String?  @map("signature_header")
  // null = no signature header was present at all (request proceeded
  // unverified, see DhdWebhookService.handle()'s comment on that trade-off)
  // — distinct from false, which means a signature WAS present and did NOT
  // match the saved secret.
  signatureValid    Boolean? @map("signature_valid")
  statusCode        Int      @map("status_code")
  errorMessage      String?  @map("error_message")
  receivedAt        DateTime @default(now()) @map("received_at")

  @@index([shippingCompanyId])
  @@index([receivedAt])
  @@map("courier_webhook_logs")
}

// A synced snapshot of one provider's per-wilaya pricing (GET /api/v1/get/fees
// for DHD) — reference data only. Deliberately NOT written into
// WilayaShippingRate automatically: syncing just refreshes this table, and
// an admin explicitly applies chosen wilayas' delivery price into the live
// WilayaShippingRate via a separate action, so a sync can never silently
// overwrite hand-tuned live prices. Home/stopdesk are independent per
// service the same way WilayaShippingRate splits home/desk delivery — a
// provider commonly prices (or even offers) stop-desk differently per
// wilaya, sometimes not at all (priced as 0 by DHD, which callers should
// treat the same as WilayaShippingRate treats a disabled price).
model ShippingCompanyTariff {
  id                         String          @id @default(uuid())
  shippingCompanyId          String          @map("shipping_company_id")
  shippingCompany            ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: Cascade)
  wilayaId                   String          @map("wilaya_id")
  wilaya                     Wilaya          @relation(fields: [wilayaId], references: [id], onDelete: Cascade)
  deliveryPriceCents         Int?            @map("delivery_price_cents")
  deliveryStopdeskPriceCents Int?            @map("delivery_stopdesk_price_cents")
  pickupPriceCents           Int?            @map("pickup_price_cents")
  pickupStopdeskPriceCents   Int?            @map("pickup_stopdesk_price_cents")
  exchangePriceCents         Int?            @map("exchange_price_cents")
  exchangeStopdeskPriceCents Int?            @map("exchange_stopdesk_price_cents")
  codFeePriceCents           Int?            @map("cod_fee_price_cents")
  codFeeStopdeskPriceCents   Int?            @map("cod_fee_stopdesk_price_cents")
  returnPriceCents           Int?            @map("return_price_cents")
  returnStopdeskPriceCents   Int?            @map("return_stopdesk_price_cents")
  updatedAt                  DateTime        @updatedAt @map("updated_at")

  @@unique([shippingCompanyId, wilayaId])
  @@map("shipping_company_tariffs")
}

// ---- Product sourcing / ad-testing operations ----
//
// Deliberately a separate pipeline from the live storefront catalog
// (Product), not a set of extra fields bolted onto it: a product spends
// most of its early life as a research/testing candidate that may never
// sell a single unit, and most of that history (ad spend, creative
// experiments, wholesaler back-and-forth) is meaningless once — or if — it
// actually goes live. SourcedProduct.linkedProductId is the one bridge
// between the two worlds, set once a candidate earns a real Product row.
enum SourcedProductStatus {
  Researching
  Testing
  TestPassed
  TestFailed
  Sourcing
  Received
  Live
  Discontinued
}

model SourcedProduct {
  id        String               @id @default(uuid())
  name      String
  // Where the product was found (AliExpress/CJ/etc listing, competitor ad,
  // whatever) — a plain link, not a structured marketplace integration.
  sourceUrl String?              @map("source_url")
  imageUrl  String?              @map("image_url")
  // Free-text category/niche tag — same lightweight pattern as Product's
  // legacy `category` field, no separate niche table for v1.
  niche     String?
  notes     String?
  status    SourcedProductStatus @default(Researching)

  // Set once this candidate is actually listed for sale — links the
  // research/testing history to the real catalog entry it produced. Nullable
  // and unique: a Product is sourced from at most one SourcedProduct, and a
  // SourcedProduct maps to at most one Product.
  linkedProductId String?  @unique @map("linked_product_id")
  linkedProduct   Product? @relation(fields: [linkedProductId], references: [id], onDelete: SetNull)

  adTests          ProductAdTest[]
  sourcingRequests ProductSourcingRequest[]
  // Full image/video gallery — imageUrl above stays as the denormalized
  // thumbnail for list views, same pattern as Product.imageUrl vs
  // Product.images.
  media            SourcedProductMedia[]
  // Reference links to where this product is listed elsewhere (supplier
  // marketplace pages, competitor stores, social ad posts, etc.) — distinct
  // from sourceUrl above, which is just "where we first found it."
  links            SourcedProductLink[]
  // Video ad-creative links (yours or a competitor's, spotted while
  // researching) — distinct from ProductAdTest.creativeUrl, which is tied to
  // one specific price/spend experiment; this is just a running collection
  // of creatives worth keeping an eye on before/while testing.
  videoCreatives   SourcedProductVideoCreative[]
  // Competing listings for this product — who else sells it, at what price,
  // and any other detail worth noting (shipping time, reviews, etc).
  competitors      SourcedProductCompetitor[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("sourced_products")
}

enum SourcedProductMediaType {
  Image
  Video
}

model SourcedProductMedia {
  id               String                  @id @default(uuid())
  sourcedProductId String                  @map("sourced_product_id")
  sourcedProduct   SourcedProduct          @relation(fields: [sourcedProductId], references: [id], onDelete: Cascade)
  type             SourcedProductMediaType
  url              String
  caption          String?
  sortOrder        Int                     @default(0) @map("sort_order")
  createdAt        DateTime                @default(now()) @map("created_at")

  @@index([sourcedProductId])
  @@map("sourced_product_media")
}

// A link to this product elsewhere on the web — the wholesaler's listing,
// a competitor selling it, the ad creative it was spotted in, etc. `label`
// is free-text (e.g. "AliExpress", "Competitor — MyShop") rather than an
// enum: the set of places a product might be linked from is unbounded and
// not worth modeling as a fixed platform list.
model SourcedProductLink {
  id               String         @id @default(uuid())
  sourcedProductId String         @map("sourced_product_id")
  sourcedProduct   SourcedProduct @relation(fields: [sourcedProductId], references: [id], onDelete: Cascade)
  label            String
  url              String
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([sourcedProductId])
  @@map("sourced_product_links")
}

// Lifecycle of a creative idea/asset, independent of ProductAdTest.status
// (which tracks one specific price/spend experiment's outcome) — this is
// "where is this creative in our testing pipeline right now."
enum VideoCreativeStatus {
  Idea
  Testing
  Winner
  Killed
}

// A video ad-creative worth keeping track of while researching/testing this
// product — yours or a competitor's. `platform` reuses AdTestPlatform
// (Facebook/TikTok/Snapchat/Google/Other) since it's the same fixed set of
// places a creative could be running; nullable because the platform isn't
// always known/relevant (e.g. a raw video file link). The marketing-angle
// fields (angle/hook/description) mirror the columns a real ad-testing
// spreadsheet tracks per creative, so this is genuinely useful for deciding
// what to test next instead of just being a bare link list.
model SourcedProductVideoCreative {
  id               String              @id @default(uuid())
  sourcedProductId String              @map("sourced_product_id")
  sourcedProduct   SourcedProduct      @relation(fields: [sourcedProductId], references: [id], onDelete: Cascade)
  url              String
  platform         AdTestPlatform?
  // Short internal label so a list of creatives is scannable at a glance
  // instead of just a wall of URLs (e.g. "UGC unboxing v2").
  name             String?
  // The marketing angle this creative is built around — e.g. "Pain point",
  // "Before/after", "Social proof", "Urgency/FOMO", "Problem-solution". Free
  // text, not an enum: angles are a matter of ad-buyer vocabulary, not a
  // fixed taxonomy worth locking down.
  angle            String?
  // The opening line/visual — what stops the scroll in the first 1-3
  // seconds. Called out separately from `description` because it's the
  // single most-scrutinized part of a video ad when deciding what to test
  // next.
  hook             String?
  // What the creative actually shows/says beyond the hook — a short script
  // summary or shot list, not the full script verbatim.
  description      String?
  status           VideoCreativeStatus @default(Idea)
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([sourcedProductId])
  @@map("sourced_product_video_creatives")
}

// A competing listing for this product — who else is selling it, at what
// price, and any other detail worth noting (shipping time, reviews, ad
// spend they appear to be running, etc — `details` is free text since this
// is research scratch space, not a structured competitor-intel system).
model SourcedProductCompetitor {
  id               String         @id @default(uuid())
  sourcedProductId String         @map("sourced_product_id")
  sourcedProduct   SourcedProduct @relation(fields: [sourcedProductId], references: [id], onDelete: Cascade)
  name             String?
  url              String
  priceCents       Int?           @map("price_cents")
  details          String?
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([sourcedProductId])
  @@map("sourced_product_competitors")
}

enum AdTestPlatform {
  Facebook
  TikTok
  Snapchat
  Google
  Other
}

enum AdCreativeType {
  Image
  Video
}

enum AdTestStatus {
  Running
  Passed
  Failed
}

// One row per (price, creative) combination tested for a candidate — "we
// test many prices, many video or images creatives and we get the best"
// (the operation this exists to support). `isWinner` flags the chosen
// combination once testing concludes; CPA/ROAS are derived from
// adSpendCents/ordersCount/revenueCents at read time rather than stored, so
// they never go stale if a number gets corrected after the fact.
model ProductAdTest {
  id               String         @id @default(uuid())
  sourcedProductId String         @map("sourced_product_id")
  sourcedProduct   SourcedProduct @relation(fields: [sourcedProductId], references: [id], onDelete: Cascade)

  platform     AdTestPlatform  @default(Other)
  priceCents   Int             @map("price_cents")
  creativeType AdCreativeType? @map("creative_type")
  // Link to the actual ad creative (uploaded video/image, or an external
  // link to it) — not a managed asset, just a reference.
  creativeUrl  String?         @map("creative_url")

  adSpendCents Int @default(0) @map("ad_spend_cents")
  ordersCount  Int @default(0) @map("orders_count")
  revenueCents Int @default(0) @map("revenue_cents")

  status    AdTestStatus @default(Running)
  isWinner  Boolean      @default(false) @map("is_winner")
  startedAt DateTime?    @map("started_at")
  endedAt   DateTime?    @map("ended_at")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sourcedProductId])
  @@map("product_ad_tests")
}

enum SourcingRequestStatus {
  Requested
  Confirmed
  Shipped
  Received
  Cancelled
}

// A stock request for a sourced product — kept as its own history table
// (not fields on SourcedProduct) since a product can reasonably be
// reordered multiple times over its life, each with its own
// quantity/cost/status. No supplier/wholesaler reference — that concept was
// removed; this is now just "we requested N units, here's the status."
model ProductSourcingRequest {
  id               String         @id @default(uuid())
  sourcedProductId String         @map("sourced_product_id")
  sourcedProduct   SourcedProduct @relation(fields: [sourcedProductId], references: [id], onDelete: Cascade)

  requestedQuantity Int                   @map("requested_quantity")
  // Destination country for this request — free text (this is an ops log,
  // not a shipping-rate integration), e.g. "Algeria".
  requestedCountry  String                @map("requested_country")
  unitCostCents     Int?                  @map("unit_cost_cents")
  status            SourcingRequestStatus @default(Requested)
  notes             String?

  requestedAt DateTime  @default(now()) @map("requested_at")
  receivedAt  DateTime? @map("received_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sourcedProductId])
  @@map("product_sourcing_requests")
}

// Storefront view-tracking — first-party, our own DB (never third-party
// pixel data, which we can't query for an admin dashboard). One row per
// page view: Home, a specific Product, or a specific ProductLandingPage
// (identified by entityId — the product's or landing page's own id,
// loosely typed as a plain string rather than an FK so a later-deleted
// product/landing page doesn't retroactively break its own view history).
// visitorId is a client-generated UUID persisted in localStorage
// (useVisitorId() in the storefront) — it's what "unique views" counts
// distinct values of; there's no login/account system to key off instead.
enum PageViewType {
  Home
  Product
  LandingPage
  Other
}

model PageViewEvent {
  id        String       @id @default(uuid())
  type      PageViewType
  entityId  String?      @map("entity_id")
  visitorId String       @map("visitor_id")
  path      String
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([entityId])
  @@index([visitorId])
  @@map("page_view_events")
}
