{
  "name": "api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@amalice/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "6.0.0",
    "bullmq": "5.80.7",
    "dotenv": "17.4.2",
    "googleapis": "^173.0.0",
    "ioredis": "5.11.1",
    "multer": "^2.2.0",
    "nestjs-zod": "5.4.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.22.0",
    "prisma": "7.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "26.1.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.0",
    "concurrently": "10.0.3",
    "source-map-support": "0.5.21",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
