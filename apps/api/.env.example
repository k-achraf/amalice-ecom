# Dev-only values — regenerate before ever pointing this at anything real.
# DATABASE_URL/REDIS_URL match the root .env.example's docker-compose credentials.

NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://amalice:amalice_dev@localhost:5433/amalice
REDIS_URL=redis://localhost:6379

# This API's own public URL — used to build the DHD webhook URL shown in
# Settings -> Shipping Companies. In production, set this to the real
# https://... address DHD's platform can reach (e.g. https://api.amalice.shop).
PUBLIC_API_URL=http://localhost:3333

JWT_SECRET=cad68fbd88d2ea863c064054abe9683202febafc8014781dfcd7e4fc71bafe06
JWT_REFRESH_SECRET=76c5090e1e6739779197d958840e53f216639ae0ebd696add98e0f90480264f8

# AI landing page builder — free key from https://aistudio.google.com/apikey.
# Leave blank to disable the feature; it fails with a clear error, not a
# broken boot.
GEMINI_API_KEY=

# Google Sheets integration (Apps -> Google Sheets in the admin) — a Google
# Cloud service account's credentials. Create one at
# console.cloud.google.com/iam-admin/serviceaccounts, enable the Google
# Sheets API for the project, download its JSON key, and share each target
# spreadsheet with its client_email like any other collaborator. Leave both
# blank to disable the feature; order pushes/status updates just no-op.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# This deployment's storefront/admin origins (comma-separated). Leave unset for amalice.shop;
# set for any other store, e.g. https://nayo.site,https://www.nayo.site,https://admin.nayo.site
# CORS_ORIGINS=

# Extra browser origins allowed by CORS (comma-separated) — the standalone funnels site (apps/funnels).
# Dev origin http://localhost:3002 is already allowed; set this for production, e.g. https://offers.example.com
CORS_EXTRA_ORIGINS=

# Meta Ads section (admin -> Meta Ads) — from developers.facebook.com -> your app -> Settings -> Basic.
# Add the admin's callback URL (e.g. http://localhost:3001/meta-ads/callback) under
# Facebook Login -> Settings -> Valid OAuth Redirect URIs. Leave blank to disable.
META_APP_ID=
META_APP_SECRET=
# Optional: encrypts stored Meta tokens. Defaults to a key derived from JWT_SECRET.
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=v23.0
