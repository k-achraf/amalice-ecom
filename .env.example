# Local infrastructure (docker-compose) — copy to .env and adjust if needed.
# Never commit the real .env; these are dev-only defaults, not secrets.

POSTGRES_USER=amalice
POSTGRES_PASSWORD=amalice_dev
POSTGRES_DB=amalice
# 5433, not Postgres's default 5432 — this machine already has a native
# Postgres install bound to 5432 that silently shadows Docker's port
# mapping (connections "succeed" but hit the wrong server entirely, with a
# confusing auth-failure error). Don't change this back without checking
# `netstat`/`Get-NetTCPConnection` for what's actually listening on 5432 first.
POSTGRES_PORT=5433

REDIS_PORT=6379

MEILI_MASTER_KEY=amalice_dev_master_key
MEILI_PORT=7700
